---
config:
  theme: base
  themeVariables:
    background: "#f4f9fc"
    fontFamily: "-apple-system, BlinkMacSystemFont, PingFang SC, sans-serif"
    primaryColor: "#f7fbfd"
    primaryTextColor: "#172229"
    primaryBorderColor: "#7ea1b4"
    lineColor: "#5d7990"
    clusterBkg: "#edf6fb"
    clusterBorder: "#7fafcf"
  flowchart:
    curve: basis
    htmlLabels: true
---
flowchart LR
  accTitle: 统一 AttemptBudget 与 ClientCommit 边界
  accDescr: 同一 Profile 的执行计划统一约束主回答和辅助调用；只有实际 dispatch 才增加相应调用计数，提交前可恢复失败可沿计划前进，ClientCommit 后禁止重试或换 Target。

  subgraph PROFILE["当前 Profile · 单一 ExecutionPlan"]
    direction LR
    PLAN["PlannedAttempt[]<br/>+ PlannedAuxiliaryAttempt[]"]
    BUDGET["AttemptBudget<br/>回答 · 辅助 · 总出站<br/>retry · Target / 模型切换<br/>deadline · 最坏成本"]
    NEXT["下一主回答<br/>PlannedAttempt"]
    GATE{"预算与 deadline<br/>仍可用？"}
    RESERVE["ProfileRuntime.reserve()"]
    RESERVED{"预留成功？"}
    NO_DISPATCH["未 dispatch<br/>不计回答 / 辅助 / 出站 / retry<br/>继续消耗 deadline；变化时计 switch"]
    COUNT["dispatch 前原子计数<br/>回答 + 总出站"]
    DISPATCH["dispatch"]
    EVENT{"首个完整合法<br/>入口协议事件？"}
    PRECOMMIT{"未 ClientCommit<br/>且可恢复？"}
    ADVANCE["仅沿计划前进<br/>按变化计 retry / switch"]
    COMMIT["ClientCommit<br/>一次性提交响应头与首事件"]
    STREAM["继续响应"]
    STOP["完成或终止<br/>不再 fallback"]

    PLAN --> NEXT --> GATE
    BUDGET --> GATE
    GATE -->|"否"| STOP
    GATE -->|"是"| RESERVE --> RESERVED
    RESERVED -->|"否"| NO_DISPATCH --> NEXT
    RESERVED -->|"是"| COUNT --> DISPATCH --> EVENT
    EVENT -->|"是"| COMMIT --> STREAM --> STOP
    EVENT -->|"否"| PRECOMMIT
    PRECOMMIT -->|"是"| ADVANCE --> NEXT
    PRECOMMIT -->|"否"| STOP
  end

  classDef primary fill:#f7fbfd,color:#172229,stroke:#526f7e,stroke-width:1.5px;
  classDef budget fill:#e8f2ff,color:#172229,stroke:#3f75a3,stroke-width:1.5px;
  classDef runtime fill:#e7f7f6,color:#172229,stroke:#2d7774,stroke-width:1.5px;
  classDef decision fill:#fff4e7,color:#172229,stroke:#965b15,stroke-width:1.5px;
  classDef commit fill:#eaf6ee,color:#172229,stroke:#34794b,stroke-width:2px;
  classDef terminal fill:#eef0ff,color:#172229,stroke:#625eb5,stroke-width:1.5px;
  class PLAN,NEXT primary;
  class BUDGET,COUNT budget;
  class RESERVE,DISPATCH,STREAM runtime;
  class GATE,RESERVED,NO_DISPATCH,EVENT,PRECOMMIT,ADVANCE decision;
  class COMMIT commit;
  class STOP terminal;
  style PROFILE fill:#edf6fb,stroke:#4a758f,stroke-width:2px,color:#172229
