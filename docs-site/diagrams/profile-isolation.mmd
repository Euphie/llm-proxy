config:
  theme: base
  themeVariables:
    background: "#f4f9fc"
    fontFamily: "-apple-system, BlinkMacSystemFont, PingFang SC, sans-serif"
    primaryColor: "#f7fbfd"
    primaryTextColor: "#172229"
    primaryBorderColor: "#7ea1b4"
    lineColor: "#5d7990"
    clusterBkg: "#edf6fb"
    clusterBorder: "#7fafcf"
  flowchart:
    curve: basis
    htmlLabels: true
---
flowchart LR
  accTitle: Profile 是永久路由边界
  accDescr: 请求通过 URL 或默认入口选定一个 Profile。之后使用的配置、策略、模型、Target、视觉增强、重试、会话与异步评测全部属于这个 Profile，不能跨 Profile 路由或回退。

  ENTRY["URL slug / 默认入口"] --> SELECT["只解析一次<br/>选定 Profile"]

  subgraph PROFILE["当前 Profile · 唯一业务边界"]
    direction TB
    CONFIG["配置与策略"] --> PLAN["路由与 ExecutionPlan"] --> RUN["主请求执行"]
    MODELS["ModelCard 与 Target"] --> PLAN
    VISION["视觉增强"] --> RUN
    RETRY["重试与 Session"] --> RUN
    RUN --> EVAL["统计与异步评测"]
  end

  SELECT --> CONFIG
  SELECT --> MODELS
  OTHER["其他 Profile"] -. "不读取 · 不回退 · 不评测" .-> BLOCK["边界外"]

  classDef entry fill:#fff4e7,color:#172229,stroke:#965b15,stroke-width:1.5px;
  classDef scope fill:#0067c5,color:#ffffff,stroke:#075daf,stroke-width:2px;
  classDef primary fill:#f7fbfd,color:#172229,stroke:#526f7e,stroke-width:1.5px;
  classDef runtime fill:#e7f7f6,color:#172229,stroke:#2d7774,stroke-width:1.5px;
  classDef blocked fill:#fff0f1,color:#172229,stroke:#a34752,stroke-width:1.5px;
  class ENTRY entry;
  class SELECT scope;
  class CONFIG,MODELS,PLAN primary;
  class VISION,RETRY,RUN,EVAL runtime;
  class OTHER,BLOCK blocked;
  style PROFILE fill:#edf6fb,stroke:#4a758f,stroke-width:2px,color:#172229
