---
flowchart TB
  accTitle: 策略从草稿到安全热加载
  accDescr: 策略使用日期加序号作为固定名称，并可设置显示别名。草稿经过评测、就绪和灰度后由管理员发布；发布版本不可修改，通过 CAS 原子切换，新请求使用新快照，在途请求继续使用旧快照。异常时只自动回滚到最后已知良好版本，发布和晋级始终需要人工确认。

  NAME["YYYYMMDD-NNN<br/>可选显示别名"] --> DRAFT["draft"] --> EVAL["evaluating"] --> READY["ready"] --> CANARY["canary"]
  CANARY --> APPROVE{"管理员晋级？"}
  APPROVE -->|"是"| PUBLISH["CAS 发布<br/>版本不可变"] --> HOTLOAD["原子热加载"] --> ACTIVE["active"]
  APPROVE -->|"否"| READY
  HOTLOAD -. "新请求" .-> NEW["使用新快照"]
  HOTLOAD -. "在途请求" .-> OLD["继续旧快照"]
  ACTIVE --> HEALTH{"可靠性门槛异常？"}
  HEALTH -->|"否"| ACTIVE
  HEALTH -->|"是"| ROLLBACK["自动回滚到 LKG"] --> ACTIVE
  DISABLE["紧急停用模型"] -. "立即生效" .-> ACTIVE

  classDef primary fill:#f7fbfd,color:#172229,stroke:#526f7e,stroke-width:1.5px;
  classDef stage fill:#e8f2ff,color:#172229,stroke:#3f75a3,stroke-width:1.5px;
  classDef decision fill:#fff4e7,color:#172229,stroke:#965b15,stroke-width:1.5px;
  classDef active fill:#eaf6ee,color:#172229,stroke:#34794b,stroke-width:2px;
  classDef snapshot fill:#eef0ff,color:#172229,stroke:#625eb5,stroke-width:1.5px;
  classDef danger fill:#fff0f1,color:#172229,stroke:#a34752,stroke-width:1.5px;
  class NAME primary;
  class DRAFT,EVAL,READY,CANARY,PUBLISH,HOTLOAD stage;
  class APPROVE,HEALTH decision;
  class ACTIVE active;
  class NEW,OLD snapshot;
  class ROLLBACK,DISABLE danger;
