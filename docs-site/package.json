{
  "name": "llm-proxy-intelligent-routing-docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "node --experimental-strip-types scripts/validate-site-origin.mjs && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "NEXT_PUBLIC_SITE_URL=https://docs.example.test npm run build && node --test tests/rendered-html.test.mjs",
    "test:content": "node --experimental-strip-types --test tests/content-contract.test.mjs tests/content-model.test.mjs",
    "test:routes": "NEXT_PUBLIC_SITE_URL=https://docs.example.test npm run build && node --test tests/routes.test.mjs",
    "test:e2e": "NEXT_PUBLIC_SITE_URL=https://docs.example.test npm run build && playwright test",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm run test:content && npm run lint && npm run typecheck && NEXT_PUBLIC_SITE_URL=https://docs.example.test npm run build && node --test tests/routes.test.mjs tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern test-results --ignore-pattern playwright-report"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
